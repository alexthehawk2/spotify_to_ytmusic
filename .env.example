# Optional Google OAuth client for YouTube Music device auth.
# Leave unset to use the app defaults, or provide your own client values.
YT_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
YT_CLIENT_SECRET=your_google_oauth_client_secret

# Optional: browser auth JSON content for YouTube Music writes.
# Recommended for personal deployments when OAuth playlist creation is unreliable.
# Store the full JSON as an Azure secret/app setting instead of committing browser.json.
# BROWSER_AUTH_JSON={"authorization":"SAPISIDHASH ...","cookie":"...","origin":"https://music.youtube.com",...}

# Optional runtime paths
# OUTPUT_DIR=/tmp/output
# FRONTEND_DIST_DIR=/app/frontend/out
